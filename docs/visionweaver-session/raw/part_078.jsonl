ity.user.id,source_system:'SYS-CEO-001',target_agent:targetAgent,action_type:`${active}: ${label}`,risk_level:risk,authorization_state:'ASK',execution_status:'queued',payload_reference:{source_page:active,requested_action:label}});setBusy(false);if(error)setNotice(error.message);else{setNotice(`Command staged for ${targetAgent}. Open THELMA to review and authorize it.`)}}\n const portfolio=command.systems.length?command.systems:[];\n const model=pages[active];\n return <div className=\"app-shell\"><aside className={open?'sidebar open':'sidebar'}><div className=\"brand\"><div className=\"brand-mark\">EC</div><div><b>ESTIBAN</b><span>CEO COMMAND</span></div><button className=\"close\" onClick={()=>setOpen(false)}><X/></button></div><nav>{sections.map(([name,Icon])=><button key={name} className={active===name?'active':''} onClick={()=>{selectPage(name);setOpen(false)}}><Icon/><span>{name}</span></button>)}</nav><div className=\"system-state\"><span className={command.connected&&!command.error?'pulse':'pulse warning'}/><div><b>{command.connected&&!command.error?'Command fabric online':'Data connection needs attention'}</b><small>{portfolio.length||6} systems reporting</small></div></div></aside><main><header><button className=\"menu\" onClick={()=>setOpen(true)}><Menu/></button><div><p>CEO COMMAND CENTER</p><h1>{active}</h1></div><label className=\"search\"><Search/><input aria-label=\"Search enterprise\" placeholder=\"Search systems, decisions, people…\"/></label><button className=\"icon-button\" onClick={()=>selectPage('Decisions & Approvals')}><Bell/><i>!</i></button><div className=\"profile\"><span>EA</span><div><b>{identity.user?.email||'The Architect'}</b><small>{identity.role.replaceAll('_',' ')}</small></div></div></header><section className=\"content\">{notice&&<div className=\"data-state loading\" role=\"status\"><b>Governed action</b><span>{notice}</span><button onClick={()=>setNotice('')}>Dismiss</button></div>}{active==='Executive Overview'?<><div className=\"briefing\"><div><span className=\"eyebrow\">EXECUTIVE OPERATING BRIEFING</span><h2>Your operating systems are one click away.</h2><p>Open the actual system workspace below. Production actions now route to the owning system or create a governed THELMA command.</p></div><button onClick={()=>selectPage('System Portfolio')}>Open system portfolio <ChevronRight/></button></div><div className=\"metrics\"><Metric label=\"VisionWeaver\" value=\"Open\" detail=\"Production studio\" tone=\"green\"/><Metric label=\"EC Fabric\" value=\"Open\" detail=\"Authorize and recover jobs\" tone=\"cyan\"/><Metric label=\"THELMA\" value=\"Open\" detail=\"Commands and incidents\" tone=\"purple\"/><Metric label=\"Core workspaces\" value=\"3\" detail=\"LandWeaver · GrantOS · CMGIO\" tone=\"amber\"/></div><div className=\"workspace-grid\"><section className=\"panel\"><div className=\"panel-title\"><div><span className=\"eyebrow\">SYSTEM LAUNCHER</span><h3>Operate the system</h3></div><Network/></div>{[{n:'