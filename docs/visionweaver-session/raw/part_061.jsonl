ingify(payload) });\n654\t    if (!task.task_id) throw new Error('Kling returned no task id');\n655\t    await db.from('vw_generations').update({\n656\t      status: 'processing', external_id: task.task_id, model: payload.model_name,\n657\t      submitted_at: new Date().toISOString(), error: null\n658\t    }).eq('id', generation.id);\n659\t    return;\n660\t  }\n661\t  let path = '';\n662\t  let payload: any = {};\n663\t  if (generation.media_type === 'image') {\n664\t    path = '/text_to_image';\n665\t    const refs = await resolveReferences(generation);\n666\t    payload = refs.length ? {\n667\t      model: await setting('runway_image_model', 'gen4_image_turbo'),\n668\t      promptText: generation.prompt.slice(0, 1000),\n669\t      ratio: parameters.ratio || '1360:768',\n670\t      referenceImages: refs\n671\t    } : {\n672\t      model: await setting('runway_image_model_noref', 'gemini_2.5_flash'),\n673\t      promptText: generation.prompt.slice(0, 1000),\n674\t      ratio: parameters.ratio || '1344:768'\n675\t    };\n676\t  } else if (generation.media_type === 'video') {\n677\t    const isExtend = Boolean(continuation.url);\n678\t    const vrefs = isExtend ? [] : await resolveReferences(generation);\n679\t    path = isExtend ? '/video_to_video' : (vrefs.length ? '/image_to_video' : '/text_to_video');\n680\t    payload = vrefs.length ? {\n681\t      model: await setting('runway_i2v_model', 'gen4.5'),\n682\t      promptImage: vrefs[0].uri,\n683\t      promptText: generation.prompt.slice(0, 1000),\n684\t      ratio: parameters.ratio || '1280:720',\n685\t      duration: Math.max(2, Math.min(SHORT_PROVIDER_SHOT_MAX_SECONDS, Number(parameters.duration) || 5))\n686\t    } : isExtend ? {\n687\t      model: generation.model || await setting('runway_long_video_model', 'seedance2_5'),\n688\t      promptText: generation.prompt.slice(0, 1000),\n689\t      promptVideo: continuation.url,\n690\t      mode: 'extend',\n691\t      duration: Math.max(4, Math.min(LONG_FORM_PROVIDER_SHOT_MAX_SECONDS, Number(parameters.duration) || 5))\n692\t    } : {\n693\t      model: generation.model || await setting('runway_model', 'gen4.5'),\n694\t      promptText: generation.prompt.slice(0, 1000),\n695\t      ratio: parameters.ratio || '1280:720',\n696\t      duration: Math.max(Number(parameters.provider_shot_max_seconds) > SHORT_PROVIDER_SHOT_MAX_SECONDS ? 4 : 2, Math.min(Number(parameters.provider_shot_max_seconds) > SHORT_PROVIDER_SHOT_MAX_SECONDS ? LONG_FORM_PROVIDER_SHOT_MAX_SECONDS : SHORT_PROVIDER_SHOT_MAX_SECONDS, Number(parameters.duration) || 5))\n697\t    };\n698\t  } else {\n699\t    path = '/sound_effect';\n700\t    payload = {\n701\t      model: await setting('runway_audio_model', 'eleven_text_to_sound_v2'),\n702\t      promptText: generation.prompt.slice(0, 1000),\n703\t      duration: Math.max(1, Math.min(30, Number(parameters.duration) || 8))\n704\t    };\n705\t  }\n706\t  await db.from('vw_generations').update({ status: 'submitting', attempts: generation.att