t.segment_index,\n466\t          segment_count: isVideoSequence ? contract.shot_durations.length : 1,\n467\t          continuity_mode: extendFromGenerationId ? 'extend' : 'reference',\n468\t          extend_from_generation_id: extendFromGenerationId\n469\t        },\n470\t        status: 'queued'\n471\t      };\n472\t    });\n473\t    const { error: childrenError } = await db.from('vw_generations').insert(children);\n474\t    if (childrenError) throw new Error('Sequence insert: ' + childrenError.message);\n475\t    if (isVideoSequence) {\n476\t      const { error: sceneError } = await db.from('vw_scenes').insert(plan.map((shot) => ({\n477\t        project_id: project.id,\n478\t        scene_no: shot.sequence_index,\n479\t        spec: {\n480\t          variant_index: shot.variant_index,\n481\t          segment_index: shot.segment_index,\n482\t          duration_seconds: shot.duration_seconds,\n483\t          target_duration_seconds: contract.target_duration_seconds,\n484\t          platform: contract.platform\n485\t        },\n486\t        runway_prompt: shot.prompt,\n487\t        qc_status: 'pending'\n488\t      })));\n489\t      if (sceneError) console.warn('[visionweaver-studio] scene ledger insert failed', { error: sceneError.message });\n490\t    }\n491\t    await db.from('vw_projects').update({\n492\t      outputs: { generation_id: parent.id, format: parentOperation, production_contract: contract }\n493\t    }).eq('id', project.id);\n494\t    await tick(user.id);\n495\t    const { data: fresh } = await db.from('vw_generations').select('*').eq('id', parent.id).single();\n496\t    return { project, generation: fresh };\n497\t  }\n498\t\n499\t  const { data: generation, error: generationError } = await db.from('vw_generations').insert({\n500\t    project_id: project.id,\n501\t    owner_id: user.id,\n502\t    media_type: mediaType,\n503\t    operation: route.operation,\n504\t    provider: route.provider,\n505\t    model: route.model,\n506\t    prompt,\n507\t    parameters: params,\n508\t    status: 'queued'\n509\t  }).select('*').single();\n510\t  if (generationError) throw new Error('Generation insert: ' + generationError.message);\n511\t  try {\n512\t    await submitGeneration(generation);\n513\t  } catch (error) {\n514\t    await db.from('vw_generations').update({ status: 'failed', error: String(error).slice(0, 1000), attempts: 1 }).eq('id', generation.id);\n515\t    await db.from('vw_projects').update({ status: 'failed', error: String(error).slice(0, 1000) }).eq('id', project.id);\n516\t    throw error;\n517\t  }\n518\t  const { data: fresh } = await db.from('vw_generations').select('*').eq('id', generation.id).single();\n519\t  return { project, generation: fresh };\n520\t}\n521\tasync function extendSource(generation: any) {\n522\t  const predecessorId = String(generation.parameters?.extend_from_generation_id || '');\n523\t  if (!predecessorId) return { ready: true, url: null as string | null };\n524\t  const { data: predecessor, error } = await db.from('vw_generations')\n525\t    .select('id,status,output_urls,storage_paths').eq('id', predecessorId).eq('owner_id', generation.owner_id).maybeSingle();\n526\t  if (error) throw new Error('Continuity predecessor lookup: ' + error.message);\n527\t  if (!predecessor || !['complete'].includes(predecessor.status)) {\n528\t    if (predecessor && ['failed', 'cancelled'].includes(predecessor.status)) {\n529\t      await db.from('vw_generations').update({\n530\t        status: 'cancelled',\n531\t        error: `Continuity predecessor ${predecessorId} did not complete; retry that shot before continuing.`\n532\t      }).eq('id', generation.id).eq('status', 'queued');\n533\t    }\n534\t    return { ready: false, url: null as string | null };\n535\t  }\n536\t  const storagePath = Array.isArray(predecessor.storage_paths) ? predecessor.storage_paths[0] : null;\n537\t  if (storagePath) {\n538\t    const { data: signed, error: signedError } = await db.storage.from('visionweaver-outputs').createSignedUrl(storagePath, 3600);\n539\t    if (!signedError && signed?.signedUrl) return { ready: true, url: signed.signedUrl };\n540\t  }\n541\t  const outputUrl = Array.isArray(predecessor.output_urls) ? predecessor.output_urls[0] : null;\n542\t  return { ready: Boolean(outputUrl), url: typeof outputUrl === 'string' ? outputUrl : null };\n543\t}\n544\t\n545\tasync function resolveReferences(generation: any) {\n546\t  const parameters = generation.parameters || {};\n547\t  const out: { uri: string; tag: string }[] = [];\n548\t  const ids: string[] = Array.isArray(parameters.reference_asset_ids) ? parameters.reference_asset_ids.slice(0, 3) : [];\n549\t  if (ids.length) {\n550\t    const { data: rows } = await db.from('vw_assets').select('id,storage_path,source_url,title,metadata').in('id', ids).eq('owner_id', generation.owner_id);\n551\t    for (const row of rows || []) {\n552\t      let uri = row.source_url || '';\n553\t      if (row.storage_path) {\n554\t        const { data } = await db.storage.from('visionweaver-outputs').createSignedUrl(row.storage_path, 3600);\n555\t        if (data?.signedUrl) uri = data.signedUrl;\n556\t      }\n557\t      if (uri) out.push({ uri, tag: String(row.metadata?.tag || 'ref' + (out.length + 1)).replace(/[^A-Za-z0-9_]/g, '').slice(0, 16) || 'ref' + (out.length + 1) });\n558\t    }\n559\t  }\n560\t  for (const uri of (Array.isArray(parameters.reference_urls) ? parameters.reference_urls : []).slice(0, 3 - out.length)) {\n561\t    if (typeof uri === 'string' && uri.startsWith('http')) out.push({ uri, tag: 'ref' + (out.length + 1) });\n562\t  }\n563\t  return out;\n564\t}\n565\t\n566\tasync function submitGeneration(generation: any) {\n567\t  if (generation.media_type === 'book' || generation.media_type === 'movie') {\n568\t    const isBook = generation.media_type === 'book';\n569\t    const targetDurationSeconds = boundedInteger(generation.parameters?.target_duration_seconds, 5400, 30, 14400);\n570\t    const targetRuntimeMinutes = Math.round(targetDurationSeconds / 60 * 10) / 10;\n571\t    const system = isBook\n572\t      ? 'You are VisionWeaver Author. Return only valid JSON. Build an original, editable book production package. Do not include markdown fences.'\n573\t      : 'You are VisionWeaver Film Architect. Return only valid JSON. Build an original, shootable movie pre-production package. Do not include markdown fences.';\n574\t    const instruction = isBook\n575\t      ? 'Create JSON with title, logline, audience, tone, outline (8 concise chapter objects with chapter, title, summary), sample_chapter (700 words maximum), cover_prompt, audiobook_direction, publishing_checklist. Keep the entire response under 3500 tokens.'\n576\t      : `Create JSON with title, logline, genre, audience, target_runtime_minutes (${targetRuntimeMinutes}), characters, three_act_outline, screenplay_treatment, scene_plan (18-30 concise objects with scene, purpose, estimated_duration_seconds), representative_shots (12 concise objects with shot, prompt, duration_seconds between 5 and 10), audio_plan, poster_prompt, trailer_prompt, render_approval_checklist and delivery_checklist. The estimated scene durations must total approximately ${targetDurationSeconds} seconds. This is a production plan, not a rendered movie. Keep the entire response under 3500 tokens.`;\n577\t    await db.from('vw_generations').update({ status: 'processing', submitted_at: new Date().toISOString(), attempts: generation.attempts + 1 }).eq('id', generation.id);\n578\t    const draft = await claude(system, generation.prompt + '\\n\\n' + instruction, 6000);\n579\t    let result;\n580\t    try {\n581\t      result = cleanJson(draft);\n582\t    } catch (_) {\n583\t      const repaired = await claude(\n584\t        'Repair the supplied material into one complete, concise, valid JSON object. Preserve the requested production fields. Return only JSON, under 3500 tokens.',\n585\t        draft.slice(0, 42000),\n586\t        6000\n587\t      );\n588\t      result = cleanJson(repaired);\n589\t    }\n590\t    result = {\n591\t      ...result,\n592\t      deliverable_state: 'plan_ready',\n593\t      target_duration_seconds: isBook ? null : targetDurationSeconds,\n594\t      rendered_duration_seconds: 0,\n595\t      requires_render_approval: !isBook\n596\t    };\n597\t    await db.from('vw_generations').update({\n598\t      status: 'complete',\n599\t      result,\n600\t      completed_at: new Date().toISOString(),\n601\t      error: null\n602\t    }).eq('id', generation.id);\n603\t    await db.from('vw_projects').update({\n604\t      status: isBook ? 'complete' : 'plan_ready',\n605\t      story_object: result,\n606\t      outputs: { generation_id: generation.id, format: isBook ? 'book_package' : 'movie_package' },\n607\t      error: null\n608\t    }).eq('id', generation.project_id);\n609\t    return;\n610\t  }\n611\t\n612\t  const parameters = generation.parameters || {};\n613\t  const continuation = generation.media_type === 'video' && parameters.continuity_mode === 'extend'\n614\t    ? await extendSource(generation)\n615\t    : { ready: true, url: null as string | null };\n616\t  if (!continuation.ready) return;\n617\t  if (generation.provider === 'elevenlabs') {\n618\t    await db.from('vw_generations').update({ status: 'processing', attempts: generation.attempts + 1, submitted_at: new Date().toISOString() }).eq('id', generation.id);\n619\t    const blob = await elevenLabsSound(generation.prompt, Number(parameters.duration) || 8);\n620\t    const path = generation.owner_id + '/' + generation.project_id + '/' + generation.id + '-0.mp3';\n621\t    const { error: uploadError } = await db.storage.from('visionweaver-outputs').upload(path, blob, { contentType: 'audio/mpeg', upsert: true });\n622\t    if (uploadError) throw new Error('Audio storage: ' + uploadError.message);\n623\t    await db.from('vw_generations').update({\n624\t      status: 'complete', storage_paths: [path], result: { provider_status: 'SUCCEEDED', o