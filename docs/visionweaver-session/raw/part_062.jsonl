empts + 1 }).eq('id', generation.id);\n707\t  const task = await runway(path, { method: 'POST', body: JSON.stringify(payload) });\n708\t  if (!task.id) throw new Error('Provider returned no task id');\n709\t  await db.from('vw_generations').update({\n710\t    status: 'processing',\n711\t    external_id: task.id,\n712\t    model: payload.model,\n713\t    submitted_at: new Date().toISOString(),\n714\t    error: null\n715\t  }).eq('id', generation.id);\n716\t}\n717\tasync function mirrorOutputs(generation: any, urls: string[]) {\n718\t  const paths: string[] = [];\n719\t  for (let index = 0; index < urls.length; index += 1) {\n720\t    try {\n721\t      const fetched = await fetch(urls[index]);\n722\t      if (!fetched.ok) continue;\n723\t      const length = Number(fetched.headers.get('content-length') || 0);\n724\t      if (length > 100 * 1024 * 1024) continue;\n725\t      const contentType = fetched.headers.get('content-type') || (generation.media_type === 'image' ? 'image/png' : generation.media_type === 'audio' ? 'audio/mpeg' : 'video/mp4');\n726\t      const extension = contentType.includes('png') ? 'png' : contentType.includes('jpeg') ? 'jpg' : contentType.includes('webp') ? 'webp' : contentType.includes('audio') ? 'mp3' : 'mp4';\n727\t      const path = generation.owner_id + '/' + generation.project_id + '/' + generation.id + '-' + index + '.' + extension;\n728\t      const blob = await fetched.blob();\n729\t      const { error } = await db.storage.from('visionweaver-outputs').upload(path, blob, { contentType, upsert: true });\n730\t      if (!error) paths.push(path);\n731\t    } catch (_) {}\n732\t  }\n733\t  return paths;\n734\t}\n735\tasync function pollGeneration(generation: any) {\n736\t  if (!generation.external_id || !['image', 'video', 'audio'].includes(generation.media_type)) return;\n737\t  let task: any;\n738\t  let status = '';\n739\t  let urls: string[] = [];\n740\t  if (generation.provider === 'kling') {\n741\t    task = await kling(\n742\t      generation.media_type === 'image'\n743\t        ? '/v1/images/generations/' + encodeURIComponent(generation.external_id)\n744\t        : '/v1/videos/text2video/' + encodeURIComponent(generation.external_id)\n745\t    );\n746\t    status = String(task.task_status || '').toUpperCase();\n747\t    const outputs = generation.media_type === 'image' ? task.task_result?.images : task.task_result?.videos;\n748\t    urls = Array.isArray(outputs) ? outputs.map((item: any) => item.url).filter((item: unknown) => typeof item === 'string') : [];\n749\t  } else {\n750\t    task = await runway('/tasks/' + encodeURIComponent(generation.external_id));\n751\t    status = String(task.status || '').toUpperCase();\n752\t    urls = Array.isArray(task.output) ? task.output.filter((item: unknown) => typeof item === 'string') : [];\n753\t  }\n754\t  const polls = generation.poll_count + 1;\n755\t  if (status === 'SUCCEEDED' || status === 'SUCCEED') {\n756\t    const paths = await mirrorOutputs(generation, urls);\n757\t    await db.from('vw_generations').update({\n758\t      status: 'complete',\n759\t      output_urls: urls,\n760\t      storage_paths: paths,\n761\t      result: { provider_status: status, output_count: urls.length },\n762\t      poll_count: polls,\n763\t      completed_at: new Date().toISOString(),\n764\t      error: null\n765\t    }).eq('id', generation.id);\n766\t    if (!generation.parent_generation_id) {\n767\t      await db.from('vw_projects').update({\n768\t        status: 'complete',\n769\t        outputs: { generation_id: generation.id, output_urls: urls, storage_paths: paths },\n770\t        error: null\n771\t      }).eq('id', generation.project_id);\n772\t    }\n773\t    for (let index = 0; index < Math.max(urls.length, paths.length); index += 1) {\n774\t      await db.from('vw_assets').insert({\n775\t        project_id: generation.project_id,\n776\t        generation_id: generation.id,\n777\t        owner_id: generation.owner_id,\n778\t        kind: generation.media_type,\n779\t        title: generation.media_type + ' output ' + (index + 1),\n780\t        storage_path: paths[index] || null,\n781\t        source_url: urls[index] || null,\n782\t        metadata: {\n783\t          provider: generation.provider,\n784\t          model: generation.model,\n785\t          sequence_index: generation.sequence_index || null,\n786\t          variant_index: generation.parameters?.variant_index || null,\n787\t          segment_index: generation.parameters?.segment_index || null,\n788\t          duration_seconds: generation.parameters?.duration || null\n789\t        }\n790\t      });\n791\t    }\n792\t  } else if (status === 'FAILED' || status === 'CANCELLED') {\n793\t    const error = String(task.task_status_msg || task.failure || task.failureCode || 'Provider generation failed').slice(0, 1000);\n794\t    await db.from('vw_generations').update({ status: 'failed', error, poll_count: polls, completed_at: new Date().toISOString() }).eq('id', generation.id);\n795\t    if (!generation.parent_generation_id) await db.from('vw_projects').update({ status: 'failed', error }).eq('id', generation.project_id);\n796\t  } else if (polls >= 60) {\n797\t    const error = 'Generation watchdog exceeded 60 polls';\n798\t    await db.from('vw_generations').update({ status: 'failed', error, poll_count: polls }).eq('id', generation.id);\n799\t    if (!generation.parent_generation_id) await db.from('vw_projects').update({ status: 'failed', error }).eq('id', generation.project_id);\n800\t  } else {\n801\t    await db.from('vw_generations').update({ poll_count: polls, result: { provider_status: status } }).eq('id', generation.id);\n802\t  }\n803\t}\n804\tasync function finalizeParents(ownerId?: string) {\n805\t  let parentQuery = db.from('vw_generations').select('*')\n806\t    .eq('provider', 'visionweaver')\n807\t    .eq('status', 'processing')\n808\t    .in('operation', ['multi_shot_video', 'image_variants'])\n809\t    .order('created_at')\n810\t    .limit(30);\n811\t  if (ownerId) parentQuery = parentQuery.eq('owner_id', ownerId);\n812\t  const { data: parents, error: parentError } = await parentQuery;\n813\t  if (parentError) throw new Error(parentError.message);\n814\t  const finalized: string[] = [];\n815\t  for (const parent of parents || []) {\n816\t    const { data: children, error: childError } = await db.from('vw_generations').select('*')\n817\t      .eq('parent_generation_id', parent.id).order('sequence_index');\n818\t    if (childError) throw new Error(childError.message);\n819\t    const complete = (children || []).filter((item: any) => item.status === 'complete');\n820\t    const failed = (children || []).filter((item: any) => ['failed', 'cancelled'].includes(item.status));\n821\t    const total = children?.length || Number(parent.sequence_count) || 0;\n822\t    const resolved = complete.length + failed.length;\n823\t    const progress = { complete: complete.length, failed: failed.length, total };\n824\t    const orderedOutputs = complete.flatMap((item: any) => item.output_urls || []);\n825\t    const orderedPaths = complete.flatMap((item: any) => item.storage_paths || []);\n826\t    const variants = Array.from({ length: Number(parent.parameters?.variant_count) || 1 }, (_, index) => {\n827\t      const variantIndex = index + 1;\n828\t      const variantChildren = (children || []).filter((item: any) => Number(item.parameters?.variant_index || 1) === variantIndex);\n829\t      return {\n830\t        variant_index: variantIndex,\n831\t        status: variantChildren.every((item: any) => item.status === 'complete') ? 'complete'\n832\t          : variantChildren.some((item: any) => item.status === 'failed') ? 'partial_or_failed' : 'processing',\n833\t        target_duration_seconds: Number(parent.parameters?.target_duration_seconds) || 0,\n834\t        segments: variantChildren.map((item: any) => ({\n835\t          generation_id: item.id,\n836\t          sequence_index: item.sequence_index,\n837\t          segment_index: item.parameters?.segment_index || 1,\n838\t          duration_seconds: Number(item.parameters?.duration) || 0,\n839\t          status: item.status,\n840\t          prompt: item.prompt,\n841\t          error: item.error || null\n842\t        }))\n843\t      };\n844\t    });\n845\t    const baseResult = {\n846\t      ...(parent.result || {}),\n847\t      deliverable_state: resolved === total && total > 0 ? 'sequence_ready' : 'rendering',\n848\t      production_contract: parent.result?.production_contract || parent.parameters,\n849\t      progress,\n850\t      variants,\n851\t      output_count: orderedOutputs.length,\n852\t      partial: failed.length > 0\n853\t    };\n854\t    if (resolved < total || total === 0) {\n855\t      await db.from('vw_generations').update({ result: baseResult }).eq('id', parent.id);\n856\t      continue;\n857\t    }\n858\t    const successful = complete.length > 0;\n859\t    const status = successful ? 'complete' : 'failed';\n860\t    const error = failed.length\n861\t      ? successful ? `${failed.length} of ${total} provider shots failed; retry to complete the sequence.` : 'Every provider shot failed.'\n862\t      : null;\n863\t    await db.from('vw_generations').update({\n864\t      status,\n865\t      output_urls: orderedOutputs,\n866\t      storage_paths: orderedPaths,\n867\t      result: baseResult,\n868\t      error,\n869\t      completed_at: new Date().toISOString()\n870\t    }).eq('id', parent.id);\n871\t    await db.from('vw_projects').update({\n872\t      status: successful ? 'complete' : 'failed',\n873\t      outputs: {\n874\t        generation_id: parent.id,\n875\t        format: parent.operation,\n876\t        output_urls: orderedOutputs,\n877\t        storage_paths: orderedPaths,\n878\t        production_contract: parent.parameters,\n879\t        partial: failed.length > 0\n880\t      },\n881\t      error\n882\t    }).eq('id', parent.project_id);\n883\t    finalized.push(parent.id);\n884\t  }\n885\t  return finalized;\n886\t}\n887\tasync function tick(ownerId?: string, generationId?: string) {\n888\t  let query = db.from('vw_generations').select('*').in('status', ['queued', 'processing'])\n889\t    .neq('provider', 'visionweaver').order('created_at').limit(8);\n890\t  if (ownerId) query = query.eq('owner_id', ownerId);\n891\t  if (generationId) query = query.eq('id', generationId);\n892\t  const { data, error } = await query;\n893\t  if (error) throw new Error(error.message);\n894\t  const acted: string[] = [];\n895\t  for (const generation of data || []) {\n896\t    try {\n897\t      if (generation.status === 'queued') {\n898\t        await submitGeneration(generation);\n899\t        acted.push('submitted:' + generation.id);\n900\t      } else if (generation.external_id) {\n901\t        await pollGeneration(generation);\n902\t        acted.push('polled:' + generation.id);\n903\t      }\n904\t    } catch (error) {\n905\t      await db.from('vw_generations').update({ status: 'failed', error: String(error).slice(0, 1000) }).eq('id', generation.id);\n906\t      acted.push('failed:' + generation.id);\n907\t    }\n908\t  }\n909\t  const finalized = await finalizeParents(ownerId);\n910\t  acted.push(...finalized.map((id) => 'finalized:' + id));\n911\t  return acted;\n912\t}\n913\tasync function retryGeneration(user: any, generationId: string) {\n914\t  if (!generationId) throw new Error('generation_id is required');\n915\t  const { data: generation, error } = await db.from('vw_generations')\n916\t    .select('*').eq('id', generationId).eq('owner_id', user.id).maybeSingle();\n917\t  if (error) throw new Error(error.message);\n918\t  if (!generation) throw new Error('Generation not found');\n919\t  const isParent = generation.provider === 'visionweaver';\n920\t  const isPartial = Boolean(generation.result?.partial);\n921\t  if (generation.status !== 'failed' && !isPartial) throw new Error('Only failed or partial generations can be retried');\n922\t  const route = await routeFor(generation.media_type, generation.parameters || {});\n923\t  if (isParent) {\n924\t    const { data: failedChildren, error: childrenError } = await db.from('vw_generations').select('id')\n925\t      .eq('parent_generation_id', generation.id).in('status', ['failed', 'cancelled']);\n926\t    if (childrenError) throw new Error(childrenError.message);\n927\t    const childIds = (failedChildren || []).map((item: any) => item.id);\n928\t    if (!childIds.length) throw new Error('No failed provider shots were found');\n929\t    const { error: childResetError } = await db.from('vw_generations').update({\n930\t      provider: route.provider,\n931\t      model: route.model,\n932\t      operation: route.operation,\n933\t      status: 'queued',\n934\t      external_id: null,\n935\t      error: null,\n936\t      poll_count: 0,\n937\t      submitted_at: null,\n938\t      completed_at: null\n939\t    }).in('id', childIds).eq('owner_id', user.id);\n940\t    if (childResetError) throw new Error(childResetError.message);\n941\t    await db.from('vw_generations').update({\n942\t      status: 'processing',\n943\t      error: null,\n944\t      completed_at: null,\n945\t      result: { ...(generation.result || {}), deliverable_state: 'rendering', partial: false }\n946\t    }).eq('id', generation.id).eq('owner_id', user.id);\n947\t    await db.from('vw_projects').update({ status: 'active', error: null }).eq('id', generation.project_id).eq('owner_id', user.id);\n948\t    const acted = await tick(user.id);\n949\t    return { acted, ...(await listWorkspace(user)) };\n950\t  }\n951\t  const { error: resetError } = await db.from('vw_generations').update({\n952\t    provider: route.provider,\n953\t    model: route.model,\n954\t    operation: route.operation,\n955\t    status: 'queued',\n956\t    external_id: null,\n957\t    error: null,\n958\t    poll_count: 0,\n959\t    submitted_at: null,\n960\t    completed_at: null\n961\t  }).eq('id', generation.id).eq('owner_id', user.id);\n962\t  if (resetError) throw new Error(resetError.message);\n963\t  await db.from('vw_projects').update({ status: 'active', error: null }).eq('id', generation.project_id).eq('owner_id', user.id);\n964\t  const acted = await tick(user.id, generation.id);\n965\t  return { acted, ...(await listWorkspace(user)) };\n966\t}\n967\tasync function importBook(user: any, body: any) {\n968\t  const title = String(body.title || 'Untitled book').slice(0, 160);\n969\t  const chapters = Array.isArray(body.chapters) ? body.chapters.slice(0, 80) : [];\n970\t  if (!chapters.length) throw new Error('No chapters supplied');\n971\t  const { data: project, error } = await db.from('vw_projects').insert({\n972\t    owner_id: user.id,\n973\t    organization_id: user.membership.organization_id,\n974\t    title,\n975\t    medium: 'book',\n976\t    source_concept: String(body.synopsis || title).slice(0, 4000),\n977\t    universe: String(body.universe || 'Crossroads of Identity'),\n978\t    status: 'active',\n979\t    output_formats: ['book']