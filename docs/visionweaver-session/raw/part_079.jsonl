VisionWeaver',t:{surface:'vision'} as Target},{n:'LandWeaver',t:{surface:'land'} as Target},{n:'GrantOS',t:{surface:'grant'} as Target},{n:'THELMA',t:{surface:'thelma'} as Target},{n:'CMGIO',t:{surface:'cmgio'} as Target},{n:'EC Integration Fabric',t:{surface:'fabric'} as Target}].map(x=><div className=\"work-row\" key={x.n}><div><b>{x.n}</b><small>Production workspace</small></div><span>OPEN</span><button onClick={()=>go(x.t)}><ChevronRight/></button></div>)}</section><section className=\"panel\"><div className=\"panel-title\"><div><span className=\"eyebrow\">EXECUTIVE CONTROL</span><h3>What needs attention</h3></div><ShieldCheck/></div><div className=\"control-grid\"><button onClick={()=>go({surface:'fabric'})}>Authorize Fabric jobs<ChevronRight/></button><button onClick={()=>go({surface:'thelma'})}>Review THELMA queue<ChevronRight/></button><button onClick={()=>go({surface:'vision'})}>Open VisionWeaver<ChevronRight/></button><button onClick={()=>selectPage('Risk, Security & Compliance')}>Security & risk<ChevronRight/></button></div></section></div></>:model?<><div className=\"briefing workspace-hero\"><div><span className=\"eyebrow\">EXECUTIVE DECISION SURFACE</span><h2>{model.question}</h2><p>Every button below either opens the real owning system or writes a governed command. No acknowledgement-only controls remain here.</p></div><button disabled={busy} onClick={()=>operationalAction('Request THELMA briefing')}>Request THELMA briefing <ChevronRight/></button></div><div className=\"metrics\">{model.metrics.map((m,i)=><Metric key={m[0]} label={m[0]} value={m[1]} detail={m[2]} tone={(['cyan','green','amber','purple']as const)[i%4]}/>)}</div><div className=\"workspace-grid\"><section className=\"panel\"><div className=\"panel-title\"><div><span className=\"eyebrow\">OPERATING QUEUE</span><h3>{active}</h3></div><span className=\"live\"><i/>Live controls</span></div>{model.queue.map(item=><div className=\"work-row\" key={item.title}><div><b>{item.title}</b><small>{item.owner}</small></div><span>{item.state}</span><button aria-label={`Open ${item.title}`} onClick={()=>go(item.target)}><ChevronRight/></button></div>)}</section><section className=\"panel\"><div className=\"panel-title\"><div><span className=\"eyebrow\">GOVERNED CONTROLS</span><h3>Executive actions</h3></div><ShieldCheck/></div><div className=\"control-grid\">{model.controls.map(label=><button disabled={busy} key={label} onClick={()=>operationalAction(label)}>{label}<ChevronRight/></button>)}</div><div className=\"provenance\"><b>Authority boundary</b><p>External provider writes still require configured credentials and explicit authorization. The UI will not report success when a provider is not connected.</p></div></section></div></>:null}</section></main></div>\n}\n\nexport default function App(){\n const[route,setRoute]=useState(()=>parseDashboardRoute(window.location.pathname));\n useEffect(()=>{const f=()=>setRoute(parseDashboardRoute(window.location.pathname));window.addEventListener('popstate',f);return()=>window.removeEventListener('popstate',f)},[]);\n useEffect(()=>{document.title=`${route.page||route.surface} · Master CEO Dashboard`},[route]);\n const navigate=(path:string)=>{if(window.location.pathname!==path)window.history.pushState({},'',path);setRoute(parseDashboardRoute(path));window.scrollTo({top:0,behavior:'auto'})};\n if(route.surface==='master')return <MasterDashboard initialActive={route.page||'Dashboard'} onNavigateModule={name=>navigate(routeForModule(name))} onOpenSuite={()=>navigate(routeForSuitePage('Executive Overview'))} onOpenLandWeaver={()=>navigate(routeForSystem('land'))} onOpenVisionWeaver={()=>navigate(routeForSystem('vision'))} onOpenGrantOS={()=>navigate(routeForSystem('grant'))} onOpenThelma={()=>navigate(routeForSystem('thelma'))} onOpenCmgio={()=>navigate(routeForSystem('cmgio'))} onOpenFabric={()=>navigate(routeForSystem('fabric'))}/>;\n if(route.surface==='suite')return <><button className=\"return-master\" onClick={()=>navigate('/dashboard')}><LayoutDashboard/> Master Dashboard</button><CSuiteDashboard initialActive={route.page||'Executive Overview'} navigate={navigate}/></>;\n const workspace=route.surface==='land'?<LandWeaverWorkspace/>:route.surface==='vision'?<VisionWeaverWorkspace/>:route.surface==='grant'?<GrantOSWorkspace/>:route.surface==='thelma'?<ThelmaWorkspace/>:route.surface==='cmgio'?<CmgioWorkspace/>:<IntegrationFabricWorkspace/>;\n return <><button className=\"return-master\" onClick={()=>navigate('/dashboard')}><LayoutDashboard/> Master Dashboard</button><div className=\"app-shell workspace-only\"><main><section className=\"content\">{workspace}</section></main></div></>;\n}\n"}]}]},"uuid":"3237063b-254b-4111-963c-69f2c2b0773b","timestamp":"2026-09-21T00:39:58.072Z","toolUseResult":[{"type":"text","text":"successfully downloaded text file (SHA: 55cebcd7a2f8fe853cdf99112ca888d837e0b38c)"},{"type":"text","text":"[Resource from GitHub at repo://estibancreations-svg/MASTER_CEO_DASHBOARD/sha/e07d3182f2239e4a67537745cb2439d8df49baae/contents/src/App.tsx] import{useEffect,useMemo,useState}from'react';\nimport{Activity,Bell,Bot,Building2,ChevronRight,CircleDollarSign,ClipboardCheck,Clock3,FileClock,Gauge,Landmark,LayoutDashboard,Megaphone,Menu,Network,Search,Settings,ShieldCheck,Sparkles,Users,X}from'lucide-react';\nimport{useCommandData}from'./hooks/useCommandData';\nimport{useIdentity}from'./auth/IdentityContext';\nimport{supabase}from'./lib/supabase';\nimport LandWeaverWorkspace from'./components/LandWeaverWorkspace';\nimport VisionWeaverWorkspace from'./components/VisionWeaverWorkspace';\nimport GrantOSWorkspace from'./components/GrantOSWorkspace';\nimport ThelmaWorkspace from'./components/ThelmaWorkspace';\nimport CmgioWorkspace from'./components/CmgioWorkspace';\nimport IntegrationFabricWorkspace from'./components/IntegrationFabricWorkspace';\nimport MasterDashboard from'./components/MasterDashboard';\nimport{parseDashboardRoute,routeForModule,routeForSuitePage,routeForS