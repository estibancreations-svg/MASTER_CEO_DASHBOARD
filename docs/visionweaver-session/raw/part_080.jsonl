Fabric failures','Live','Dead letters'],['System audit','Live','Evidence'],['Human review','Enforced','High risk']],queue:[{title:'VisionWeaver QC',owner:'VisionWeaver',state:'Open',target:{surface:'vision'}},{title:'Fabric Dead Letters',owner:'EC Fabric',state:'Open',target:{surface:'fabric'}},{title:'System Audit',owner:'Master OS',state:'Open',target:{module:'System Audit'}}],controls:['Open VisionWeaver','Open EC Fabric','Open system audit','Request remediation']},\n 'Resource & Usage':{question:'Are compute, credits, vendors and workloads being used efficiently?',metrics:[['Fabric usage','Live','Jobs'],['CMGIO spend','Live','Campaigns'],['Agent cost','Live','THELMA'],['Finance','Live','Master OS']],queue:[{title:'Fabric usage',owner:'Infrastructure',state:'Open',target:{surface:'fabric'}},{title:'CMGIO usage',owner:'Growth',state:'Open',target:{surface:'cmgio'}},{title:'THELMA usage',owner:'Operations',state:'Open',target:{surface:'thelma'}},{title:'Finance',owner:'Business',state:'Open',target:{module:'Finance'}}],controls:['Open EC Fabric','Open CMGIO','Open THELMA','Open finance']},\n 'Audit & History':{question:'What happened, who authorized it and where is the source record?',metrics:[['Fabric events','Live','Job history'],['Master activity','Live','Module history'],['Agent runs','Live','THELMA'],['Source control','GitHub','Production']],queue:[{title:'EC Fabric audit',owner:'Infrastructure',state:'Open',target:{surface:'fabric'}},{title:'Agent logs',owner:'Master OS',state:'Open',target:{module:'Agent Logs'}},{title:'System Audit',owner:'Master OS',state:'Open',target:{module:'System Audit'}}],controls:['Open EC Fabric','Open agent logs','Open system audit']},\n 'Settings & Governance':{question:'What executive settings and governed configuration are active?',metrics:[['Settings','Live','Master OS'],['API Integration','Live','Fabric registry'],['Authority','Scoped','Membership'],['Authentication','Supabase','Zero trust']],queue:[{title:'Settings',owner:'Master OS',state:'Open',target:{module:'Settings'}},{title:'API Integration',owner:'EC Fabric',state:'Open',target:{surface:'fabric'}},{title:'THELMA governance',owner:'Operations',state:'Open',target:{surface:'thelma'}}],controls:['Open settings','Open EC Fabric','Open THELMA','Request governance review']}\n};\n\nfunction Metric({label,value,detail,tone}:{label:string;value:string;detail:string;tone:'cyan'|'purple'|'green'|'amber'}){return <article className={`metric ${tone}`}><span>{label}</span><strong>{value}</strong><small>{detail}</small></article>}\n\nfunction CSuiteDashboard({initialActive='Executive Overview',navigate}:{initialActive?:string;navigate:(path:string)=>void}){\n const identity=useIdentity(),command=useCommandData();\n const[active,setActive]=useState(initialActive),[open,setOpen]=useState(false),[notice,setNotice]=useState(''),[busy,setBusy]=useState(false);\n useEffect(()=>setActive(initialActive),[initialActive]);\n const selectPage=(page:string)=>{setActive(page);navigate(routeForSuitePage(page))};\n const go=(target:Target)=>{if(target.surface)navigate(routeForSystem(target.surface));else if(target.module)navigate(routeForModule(target.module));else if(target.suite)selectPage(target.suite)};\n const systemTarget=(label:string):Target|null=>{const x=label.toLowerCase();if(x.includes('vision'))return{surface:'vision'};if(x.includes('land'))return{surface:'land'};if(x.includes('grant'))return{surface:'grant'};if(x.includes('thelma'))return{surface:'thelma'};if(x.includes('cmgio'))return{surface:'cmgio'};if(x.includes('fabric')||x.includes('authorization queue'))return{surface:'fabric'};if(x.includes('finance'))return{module:'Finance'};if(x.includes('revenue'))return{module:'Revenue Report'};if(x.includes('content'))return{module:'Content Engine'};if(x.includes('social analytics'))return{module:'Social Analytics'};if(x.includes('communications'))return{module:'Communications'};if(x.includes('roster')||x.includes('agent logs'))return{surface:'thelma'};if(x.includes('system audit'))return{module:'System Audit'};if(x.includes('settings'))return{module:'Settings'};if(x.includes('documents'))return{module:'Documents'};if(x.includes('trends'))return{module:'Trends'};return null};\n async function operationalAction(label:string){const target=systemTarget(label);if(target){go(target);return}if(!supabase||!identity.user){setNotice('Sign in is required for governed commands.');return}setBusy(true);const targetAgent=active.includes('Property')?'LANDWEAVER':active.includes('Grant')?'GRANTOS':active.includes('Growth')?'CMGIO':active.includes('Quality')?'AUDITOR':'THELMA';const risk=/escalate|security|authority|approve/i.test(label)?'high':'medium';const{error}=await supabase.from('orchestration_commands').insert({organization_id:identity.organizationId,requested_by:identity.user.id,source_system:'SYS-CEO-001',target_agent:targetAgent,action_type:`${active}: ${label}`,risk_level:risk,authorization_state:'ASK',execution_status:'queued',payload_reference:{source_page:active,requested_action:label}});setBusy(false);if(error)setNotice(error.message);else{setNotice(`Command staged for ${targetAgent}. Open THELMA to review and authorize it.`)}}\n const portfolio=command.systems.length?command.systems:[];\n const model=pages[active];\n return <div className=\"app-shell\"><aside className={open?'sidebar open':'sidebar'}><div className=\"brand\"><div className=\"brand-mark\">EC</div><div><b>ESTIBAN</b><span>CEO COMMAND</span></div><button className=\"close\" onClick={()=>setOpen(false)}><X/></button></div><nav>{sections.map(([name,Icon])=><button key={name} className={active===name?'active':''} onClick={()=>{selectPage(name);setOpen(false)}}><Icon/><span>{name}</span></button>)}</nav><div className=\"system-state\"><span className={command.connected&&!command.error?'pulse':'pulse warning'}/><div><b>{command.connected&&!command.error?'Command fabric online':'Data connection needs attention'}</b><small>{portfolio.length||6} systems reporting</small></div></div></aside><main><header><button className=\"menu\" onClick={()=>setOpen(true)}><Menu/></button><div><p>CEO COMMAND CENTER</p><h1>{active}</h1></div><label className=\"search\"><Search/><input aria-label=\"Search enterprise\" placeholder=\"Search systems, decisions, people…\"/></label><button className=\"icon-button\" onClick={()=>selectPage('Decisions & Approvals')}><Bell/><i>!</i></button><div className=\"profile\"><span>EA</span><div><b>{identity.user?.email||'The Architect'}</b><small>{identity.role.replaceAll('_',' ')}</small></div></div></header><section className=\"content\">{notice&&<div className=\"data-state loading\" role=\"status\"><b>Governed action</b><span>{notice}</span><button onClick={()=>setNotice('')}>Dismiss</button></div>}{active==='Executive Overview'?<><div className=\"briefing\"><div><span className=\"eyebrow\">EXECUTIVE OPERATING BRIEFING</span><h2>Your operating systems are one click away.</h2><p>Open the actual system workspace below. Production actions now route to the owning system or create a governed THELMA command.</p></div><button onClick={()=>selectPage('System Portfolio')}>Open system portfolio <ChevronRight/></button></div><div className=\"metrics\"><Metric label=\"VisionWeaver\" value=\"Open\" detail=\"Production studio\" tone=\"green\"/><Metric label=\"EC Fabric\" value=\"Open\" detail=\"Authorize and recover jobs\" tone=\"cyan\"/><Metric label=\"THELMA\" value=\"Open\" detail=\"Commands and incidents\" tone=\"purple\"/><Metric label=\"Core workspaces\" value=\"3\" detail=\"LandWeaver · GrantOS · CMGIO\" tone=\"amber\"/></div><div className=\"workspace-grid\"><section className=\"panel\"><div className=\"panel-title\"><div><span className=\"eyebrow\">SYSTEM LAUNCHER</span><h3>Operate the system</h3></div><Network/></div>{[{n:'VisionWeaver',t:{surface:'vision'} as Target},{n:'LandWeaver',t:{surface:'land'} as Target},{n:'GrantOS',t:{surface:'grant'} as Target},{n:'THELMA',t:{surface:'thelma'} as Target},{n:'CMGIO',t:{surface:'cmgio'} as Target},{n:'EC Integration Fabric',t:{surface:'fabric'} as Target}].map(x=><div className=\"work-row\" key={x.n}><div><b>{x.n}</b><small>Production workspace</small></div><span>OPEN</span><button onClick={()=>go(x.t)}><ChevronRight/></button></div>)}</section><section className=\"panel\"><div className=\"panel-title\"><div><span className=\"eyebrow\">EXECUTIVE CONTROL</span><h3>What needs attention</h3></div><ShieldCheck/></div><div className=\"control-grid\"><button onClick={()=>go({surface:'fabric'})}>Authorize Fabric jobs<ChevronRight/></button><button onClick={()=>go({surface:'thelma'})}>Review THELMA queue<ChevronRight/></button><button onClick={()=>go({surface:'vision'})}>Open VisionWeaver<ChevronRight/></button><button onClick={()=>selectPage('Risk, Security & Compliance')}>Security & risk<ChevronRight/></button></div></section></div></>:model?<><div className=\"briefing workspace-hero\"><div><span className=\"eyebrow\">EXECUTIVE DECISION SURFACE</span><h2>{model.question}</h2><p>Every button below either opens the real owning system or writes a governed command. No acknowledgement-only controls remain here.</p></div><button disabled={busy} onClick={()=>operationalAction('Request THELMA briefing')}>Request THELMA briefing <ChevronRight/></button></div><div className=\"metrics\">{model.metrics.map((m,i)=><Metric key={m[0]} label={m[0]} value={m[1]} detail={m[2]} tone={(['cyan','green','amber','purple']as const)[i%4]}/>)}</div><div className=\"workspace-grid\"><section className=\"panel\"><div className=\"panel-title\"><div><span className=\"eyebrow\">OPERATING QUEUE</span><h3>{active}</h3></div><span className=\"live\"><i/>Live controls</span></div>{model.queue.map(item=><div className=\"work-row\" key={item.title}><div><b>{item.title}</b><small>{item.owner}</small></div><span>{item.state}</span><button aria-label={`Open ${item.title}`} onClick={()=>go(item.target)}><ChevronRight/></button></div>)}</section><section className=\"panel\"><div className=\"panel-title\"><div><span className=\"eyebrow\">GOVERNED CONTROLS</span><h3>Executive actions</h3></div><ShieldCheck/></div><div className=\"control-grid\">{model.controls.map(label=><button disabled={busy} key={label} onClick={()=>operationalAction(label)}>{label}<ChevronRight/></button>)}</div><div className=\"provenance\"><b>Authority boundary</b><p>External provider writes still require configured credentials and explicit authorization. The UI will not report success when a provider is not connected.</p></div></section></div></>:null}</section></main></div>\n}\n\nexport default function App(){\n const[route,setRoute]=useState(()=>parseDashboardRoute(window.location.pathname));\n useEffect(()=>{const f=()=>setRoute(parseDashboardRoute(window.location.pathname));window.addEventListener('popstate',f);return()=>window.removeEventListener('popstate',f)},[]);\n useEffect(()=>{document.title=`${route.page||route.surface} · Master CEO Dashboard`},[route]);\n const navigate=(path:string)=>{if(window.location.pathname!==path)window.history.pushState({},'',path);setRoute(parseDashboardRoute(path));window.scrollTo({top:0,behavior:'auto'})};\n if(route.surface==='master')return <MasterDashboard initialActive={route.page||'Dashboard'} onNavigateModule={name=>navigate(routeForModule(name))} onOpenSuite={()=>navigate(routeForSuitePage('Executive Overview'))} onOpenLandWeaver={()=>navigate(routeForSystem('land'))} onOpenVisionWeaver={()=>navigate(routeForSystem('vision'))} onOpenGrantOS={()=>navigate(routeForSystem('grant'))} onOpenThelma={()=>navigate(routeForSystem('thelma'))} onOpenCmgio={()=>navigate(routeForSystem('cmgio'))} onOpenFabric={()=>navigate(routeForSystem('fabric'))}/>;\n if(route.surface==='suite')return <><button className=\"return-master\" onClick={()=>navigate('/dashboard')}><LayoutDashboard/> Master Dashboard</button><CSuiteDashboard initialActive={route.page||'Executive Overview'} navigate={navigate}/></>;\n const workspace=rout